# Good Pets Environment Variables (PRD Section 10)
# Configure actual secrets in Vercel environment variables or .env.local (never commit secrets).
#
# DATABASE_URL  — pooled connection string (used by the Prisma client at runtime).
# DIRECT_URL    — non-pooled direct connection string (used by Prisma CLI migrations only).
# When using Supabase, DATABASE_URL connects through the PgBouncer pooler (port 6543, ?pgbouncer=true)
# and DIRECT_URL connects directly or through the session-mode pooler (port 5432).
# Both values must be present before running: npx prisma migrate deploy

DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SENTRY_DSN=
SUPPORT_INBOX_EMAIL=
EMAIL_ALLOWLIST=
SEED_MANAGER_EMAIL=
SEED_FRONTDESK_EMAIL=
